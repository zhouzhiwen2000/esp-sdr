CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_SDR_TRANSPORT_ETHERNET=y
CONFIG_ESP_SDR_TRANSPORT_USB=y
CONFIG_ESP_SDR_S31_TX_PIE_REFILL=y
CONFIG_ESP_SDR_S31_TX_DIRECT_DMA_REFILL=y
# CONFIG_ESP_SDR_S31_TX_PIPELINED_REFILL is not set
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
# Keep the scheduler API in internal IRAM; avoiding flash/PSRAM XIP stalls is
# required for native-USB TX throughput. Moving mDNS/HTTP tasks to PSRAM leaves
# internal heap for the full GMAC RX ring, whose stopped buffers are borrowed
# as the native-USB realtime DIRAM staging ring.
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_ETH_USE_ESP32_EMAC=y
# CONFIG_ETH_USE_SPI_ETHERNET is not set
CONFIG_ETH_DMA_BUFFER_SIZE=1536
CONFIG_ETH_DMA_RX_BUFFER_NUM=15
# CONFIG_ETH_SOFT_FLOW_CONTROL is not set
CONFIG_ETH_DMA_TX_BUFFER_NUM=12
CONFIG_ETH_TRANSMIT_MUTEX=y
CONFIG_ETH_IRAM_OPTIMIZATION=y
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_TASK_PRIO=21
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
# CONFIG_PM_SLEEP_FUNC_IN_IRAM is not set
# CONFIG_PM_SLP_IRAM_OPT is not set
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_GMAC_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=2
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=4
# CONFIG_WIFI_RMT_AMPDU_TX_ENABLED is not set
# CONFIG_WIFI_RMT_AMPDU_RX_ENABLED is not set
# CONFIG_WIFI_RMT_NVS_ENABLED is not set
# CONFIG_WIFI_RMT_ENABLE_WPA3_SAE is not set
# CONFIG_WIFI_RMT_ENABLE_WPA3_OWE_STA is not set
# CONFIG_WIFI_RMT_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_WIFI_RMT_GMAC_SUPPORT is not set
# CONFIG_WIFI_RMT_ENTERPRISE_SUPPORT is not set
CONFIG_WIFI_RMT_RX_MGMT_BUF_NUM_DEF=2
CONFIG_WIFI_RMT_MGMT_SBUF_NUM=6
# CONFIG_WIFI_RMT_IRAM_OPT is not set
# CONFIG_WIFI_RMT_EXTRA_IRAM_OPT is not set
# CONFIG_WIFI_RMT_RX_IRAM_OPT is not set
# CONFIG_WIFI_RMT_SLP_IRAM_OPT is not set
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096
