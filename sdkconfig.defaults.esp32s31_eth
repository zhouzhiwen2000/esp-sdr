# Apply after sdkconfig.defaults.esp32s31, for Function CoreBoard-1 only.
CONFIG_ESP_SDR_S31_ETHERNET=y
CONFIG_ETH_USE_ESP32_EMAC=y
# CONFIG_ETH_USE_SPI_ETHERNET is not set
CONFIG_ETH_DMA_BUFFER_SIZE=1536
CONFIG_ETH_DMA_RX_BUFFER_NUM=6
CONFIG_ETH_DMA_TX_BUFFER_NUM=8
CONFIG_ETH_TRANSMIT_MUTEX=y
CONFIG_ETH_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_PRIO=20
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# PSRAM and RGMII share a PLL: 250 MHz permits the 125 MHz RGMII clock.
CONFIG_SPIRAM_SPEED_250M=y
# CONFIG_SPIRAM_SPEED_200M is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=114688
CONFIG_LWIP_TCP_WND_DEFAULT=262140
CONFIG_LWIP_TCP_TMR_INTERVAL=100
CONFIG_LWIP_TCP_RTO_TIME=200

CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=2

CONFIG_LWIP_IRAM_OPTIMIZATION=y

CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
